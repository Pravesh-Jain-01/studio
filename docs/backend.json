
{
  "entities": {
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user of the SoftSaath website.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user entity."
        },
        "name": {
          "type": "string",
          "description": "The user's name."
        },
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "dob": {
          "type": "string",
          "description": "Date of birth of the user in DD/MM/YYYY format."
        },
        "phoneNumber": {
          "type": "string",
          "description": "Phone number of the user."
        },
        "gender": {
          "type": "string",
          "description": "Gender of the user.",
          "enum": [
            "male",
            "female",
            "other",
            "prefer-not-to-say"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "email",
        "dob",
        "phoneNumber",
        "gender"
      ]
    },
    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Order",
      "type": "object",
      "description": "Represents a customer's order.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the order."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who placed the order."
        },
        "items": {
          "type": "array",
          "description": "The products included in the order.",
          "items": {
            "type": "object"
          }
        },
        "total": {
          "type": "number",
          "description": "The total cost of the order."
        },
        "shippingDetails": {
          "type": "object",
          "description": "The shipping address for the order."
        },
        "status": {
          "type": "string",
          "description": "The current status of the order.",
          "enum": ["placed", "shipped", "delivered", "cancelled"]
        },
        "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the order was created."
        }
      },
      "required": ["id", "userId", "items", "total", "shippingDetails", "status", "createdAt"]
    },
    "ContactMessage": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Contact Message",
      "type": "object",
      "description": "Represents a message submitted through the contact form.",
      "properties": {
        "name": {
          "type": "string",
          "description": "The name of the person sending the message."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the sender."
        },
        "message": {
          "type": "string",
          "description": "The content of the message."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the message was sent."
        }
      },
      "required": ["name", "email", "message", "createdAt"]
    },
     "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "description": "Represents a product in the SoftSaath store.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the product." },
        "quote": { "type": "string", "description": "The quote printed on the product." },
        "description": { "type": "string", "description": "A description of the product." },
        "baseSku": { "type": "string", "description": "The base SKU for the product, used to generate variant SKUs." },
        "designCode": { "type": "string", "description": "The design code from Qikink for the design to be printed." },
        "mockupLink": { "type": "string", "description": "A public URL for the product's mockup image, for Qikink." },
        "details": {
          "type": "object",
          "properties": {
            "fit": { "type": "string" },
            "fabric": { "type": "string" },
            "feel": { "type": "string" }
          },
           "required": ["fit", "fabric", "feel"]
        },
        "collection": { "type": "string", "enum": ["drop-01"] },
        "variants": {
          "type": "array",
          "description": "Different versions of the product (e.g., by size, color, fit).",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "imageUrl": { "type": "string", "description": "A public URL for the variant's image." },
              "fit": { "type": "string", "enum": ["oversized", "regular"] },
              "color": { "type": "string", "enum": ["beige", "white", "black", "navy-blue"] },
              "size": { "type": "string", "enum": ["xs", "s", "m", "l", "xl", "xxl"] },
              "price": { "type": "number" },
              "stock": { "type": "number" },
              "qikinkSku": { "type": "string", "description": "The specific SKU for this variant, used for Qikink." },
              "baseSku": { "type": "string", "description": "The Base SKU for this variant, used for Qikink." }
            },
            "required": ["id", "imageUrl", "fit", "color", "size", "price", "stock", "qikinkSku"]
          }
        }
      },
      "required": ["id", "quote", "description", "details", "collection", "variants", "baseSku", "designCode"]
    },
    "NewsletterSubscriber": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Newsletter Subscriber",
      "type": "object",
      "description": "Represents an email subscribed to the newsletter.",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "description": "The email address of the subscriber."
        },
        "subscribedAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user subscribed."
        }
      },
      "required": ["email", "subscribedAt"]
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user data. Path-based ownership ensures only the authenticated user can access their own data."
        }
      },
      {
        "path": "/users/{userId}/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "schema": {
            "$ref": "#/backend/entities/Order"
          },
          "description": "Stores orders for each user. Path-based ownership ensures users can only access their own orders."
        }
      },
      {
        "path": "/contact-messages/{messageId}",
        "definition": {
          "entityName": "ContactMessage",
          "schema": {
            "$ref": "#/backend/entities/ContactMessage"
          },
          "description": "Stores messages submitted from the contact form."
        }
      },
       {
        "path": "/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": {
            "$ref": "#/backend/entities/Product"
          },
          "description": "Stores all available products."
        }
      },
      {
        "path": "/newsletter-subscribers/{subscriberId}",
        "definition": {
          "entityName": "NewsletterSubscriber",
          "schema": {
            "$ref": "#/backend/entities/NewsletterSubscriber"
          },
          "description": "Stores email addresses for the newsletter."
        }
      }
    ]
  }
}
