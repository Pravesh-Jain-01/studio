
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "admin@example.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Helper function to ensure only stock is decremented in variants.
    // This version is robust against reordering of the variants array.
    function areVariantChangesValid(variantsBefore, variantsAfter) {
      // Ensure the number of variants hasn't changed.
      if (variantsBefore.size() != variantsAfter.size()) {
        return false;
      }

      // Check each variant from the 'before' state against the 'after' state.
      return variantsBefore.all(b_variant => {
        // Find the corresponding variant in the 'after' list by its ID.
        let a_variants = variantsAfter.filter(a_variant => a_variant.id == b_variant.id);

        // There must be exactly one matching variant.
        if (a_variants.size() != 1) {
          return false;
        }
        let a_variant = a_variants[0];

        // Now compare properties.
        let imageUrlMatch = b_variant.imageUrl == a_variant.imageUrl ||
                            (b_variant.imageUrl == null && a_variant.imageUrl == "") ||
                            (b_variant.imageUrl == "" && a_variant.imageUrl == null);

        let otherPropsMatch = b_variant.fit == a_variant.fit &&
                              b_variant.color == a_variant.color &&
                              b_variant.size == a_variant.size &&
                              b_variant.price == a_variant.price;

        let propsMatch = imageUrlMatch && otherPropsMatch;

        // Check if stock is either unchanged or has been validly decremented.
        let stockChangeIsValid = b_variant.stock == a_variant.stock ||
                                 (b_variant.stock > a_variant.stock && a_variant.stock >= 0);

        // This expression must be true for every variant in the 'before' list.
        return propsMatch && stockChangeIsValid;
      });
    }


    // User Profile Rules
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow list: if isAdmin();

      // User Order Rules (as a subcollection)
      match /orders/{orderId} {
        allow create: if isOwner(userId);
        allow read: if isOwner(userId) || isAdmin();
        // Allow admin to list orders across all users
        allow list: if isAdmin(); 
        // Allow user to update their own order only to cancel it.
        // Allow admin to perform any update.
        allow update: if (isOwner(userId) && 
                        request.writeFields.size() == 1 &&
                        'status' in request.writeFields &&
                        request.resource.data.status == 'cancelled' &&
                        resource.data.status == 'placed') 
                      || isAdmin();
        // Clients should not be able to delete orders
        allow delete: if false;
      }
    }

    // Public Contact Form Rules
    match /contact-messages/{messageId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }
    
    // Product Rules
    match /products/{productId} {
      // Allow anyone to read products
      allow read, list: if true;
      
      // Only admin can create, or delete products
      allow create, delete: if isAdmin();

      // Admins can perform any update.
      // Signed-in users can only update a product to decrement stock for a purchase.
      allow update: if isAdmin() || (
        isSignedIn() &&
        // Check that only the 'variants' field is being modified
        request.writeFields.size() == 1 && 'variants' in request.writeFields &&
        // Use a helper function to validate the changes within the variants list
        areVariantChangesValid(resource.data.variants, request.resource.data.variants)
      );
    }

    // Newsletter Subscribers Rules
    match /newsletter-subscribers/{subscriberId} {
        // Anyone can subscribe
        allow create: if true;
        // Only admin can see the list of subscribers
        allow read, list, update, delete: if isAdmin();
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Product images are public readable, but only writable by admins.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@example.com';
    }
  }
}
