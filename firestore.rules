rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (request.auth.token.email == "admin@example.com" || request.auth.token.admin == true);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow list: if isAdmin();

      // User Order Rules (as a subcollection)
      match /orders/{orderId} {
        allow create: if isOwner(userId);
        allow read, list: if isOwner(userId) || isAdmin();
        // Orders should be immutable by clients after creation
        allow update, delete: if false;
      }
    }
    
    // Admin-specific rule for listing all orders across all users
    match /{path=**}/orders/{orderId} {
        allow list: if isAdmin();
    }

    // Public Contact Form Rules
    match /contact-messages/{messageId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }
    
    // Product Rules
    match /products/{productId} {
      // Allow anyone to read products
      allow read, list: if true;
      // Only admin can create, update, or delete products
      allow create, update, delete: if isAdmin();
    }
  }
}
