/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model for user and order data. The contact form is a public write endpoint.
 *
 * Data Structure: 
 * - All user-specific data is stored in a top-level 'users' collection.
 * - Orders are a subcollection under each user's document.
 * - Contact messages are stored in a top-level 'contact-messages' collection.
 *
 * Key Security Decisions:
 * - User Privacy: Listing the entire /users collection is forbidden.
 * - Strict Ownership: Users can only read/write their own user document.
 * - Order Security: Users can create and read their own orders. Orders are immutable after creation.
 * - Contact Form: Anyone can create a contact message. Reading/listing/updating/deleting contact messages is disabled for clients to protect privacy.
 * - Self-Creation: An authenticated user can create their own user document.
 * - Data Integrity: The internal 'id' field of a user document must match the user's UID and is immutable.
 * - Admin Access: A designated admin email has special read-only privileges for system-wide data like all orders.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the user is the designated admin.
     * NOTE: In a production app, this should be done using Custom Claims, not by email.
     * This method is used for development simplicity.
     */
    function isAdmin() {
      // Allow for an environment variable or default to a safe value
      return isSignedIn() && request.auth.token.email == "admin@example.com";
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the fundamental ownership check.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Ensures an operation is performed by the document owner and that the document already exists.
     * Crucial for safe update and delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates a user is creating their own user document.
     * Enforces that the internal 'id' field matches the user's auth UID for relational integrity.
     */
    function isCreatingOwnUserData(userId) {
      return isOwner(userId) && request.resource.data.id == userId;
    }

    /**
     * Validates a user is updating their own document while preserving immutable fields.
     * Enforces that the 'id' field cannot be changed after creation.
     */
    function isUpdatingOwnUserData(userId) {
      return isExistingOwner(userId) && request.resource.data.id == resource.data.id;
    }


    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Manages access to individual user documents and their subcollections.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); // Allow admin to list users.
      allow create: if isCreatingOwnUserData(userId);
      allow update: if isUpdatingOwnUserData(userId);
      allow delete: if isExistingOwner(userId);

      /**
       * @description Manages user orders.
       * @path /users/{userId}/orders/{orderId}
       * @allow A user can create new orders for themselves.
       * @allow A user can read or list their own past orders.
       * @allow An admin can read or list any order.
       * @deny A user cannot update or delete an order once it is placed to maintain integrity.
       */
      match /orders/{orderId} {
        allow create: if isOwner(userId);
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow update, delete: if false; // Orders are immutable once created.
      }
    }

    /**
     * @description Manages contact form submissions.
     * @path /contact-messages/{messageId}
     * @allow Anyone can create a new message (submit the form).
     * @deny Reading, listing, updating, or deleting is disallowed for client-side security (unless admin).
     */
    match /contact-messages/{messageId} {
      allow create: if true;
      allow get, list: if isAdmin();
      allow update, delete: if false;
    }
  }
}
