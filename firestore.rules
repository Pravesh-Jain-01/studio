
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "admin@example.com";
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Check if only the status is being changed to 'cancelled'
    function isCancellingOrder(requestData, resourceData) {
      return requestData.status == 'cancelled'
        && resourceData.status == 'placed'
        && requestData.keys().hasOnly(['status']);
    }
    
    function areOrderFieldsUnchanged(requestData, resourceData) {
        let otherFields = resourceData.keys().removeAll(['status', 'createdAt']);
        return requestData.keys().hasAll(otherFields) &&
               requestData.size() == otherFields.size() + 1 &&
               requestData.userId == resourceData.userId &&
               requestData.items == resourceData.items &&
               requestData.total == resourceData.total &&
               requestData.shippingDetails == resourceData.shippingDetails;
    }

    // User Profile Rules
    match /users/{userId} {
      allow read, update, delete: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow list: if isAdmin();

      // User Order Rules (as a subcollection)
      match /orders/{orderId} {
        allow create: if isOwner(userId);
        allow read: if isOwner(userId) || isAdmin();
        // Allow admin to list orders across all users
        allow list: if isAdmin(); 
        // Allow user to update their own order only to cancel it.
        // Allow admin to perform any update.
        allow update: if (isOwner(userId) 
                        && request.resource.data.status == 'cancelled' 
                        && resource.data.status == 'placed'
                        && areOrderFieldsUnchanged(request.resource.data, resource.data))
                      || isAdmin();
        // Clients should not be able to delete orders
        allow delete: if false;
      }
    }

    // Public Contact Form Rules
    match /contact-messages/{messageId} {
      allow create: if true;
      allow read, list, update, delete: if isAdmin();
    }
    
    // Product Rules
    match /products/{productId} {
      // Allow anyone to read products
      allow read, list: if true;
      // Only admin can create, update, or delete products
      allow create, update, delete: if isAdmin();
    }

    // Newsletter Subscribers Rules
    match /newsletter-subscribers/{subscriberId} {
        // Anyone can subscribe
        allow create: if true;
        // Only admin can see the list of subscribers
        allow read, list, update, delete: if isAdmin();
    }
  }
}

service firebase.storage {
  match /b/{bucket}/o {
    // Allow admin users to read, write, and delete any files.
    match /{allPaths=**} {
      allow read, write, delete: if request.auth != null && request.auth.token.email == 'admin@example.com';
    }
  }
}
