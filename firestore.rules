/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model. Each user has exclusive control over their own data, and there is no concept of public or shared data. The primary goal is to secure user profile information and their order history.
 *
 * Data Structure: 
 * - All user-specific data is stored in a top-level 'users' collection. Each user's data is contained within a document where the document ID matches the user's authentication UID (e.g., /users/{userId}).
 * - Orders are stored as a subcollection under each user's document (e.g., /users/{userId}/orders/{orderId}). This naturally scopes order data to the user who created it.
 *
 * Key Security Decisions:
 * - User Privacy: Listing the entire /users collection is explicitly forbidden to prevent enumeration of all application users.
 * - Strict Ownership: Users can only read, create, update, or delete their own user document. All operations are gated by matching the requestor's UID with the document's ID in the path.
 * - Order Security: A user can create orders within their own subcollection. They can also read their own orders (e.g., for an order history page). Listing orders is allowed for the owner. Updates and deletes are disallowed to maintain order integrity once placed.
 * - Self-Creation: An authenticated user is permitted to create their own user document, establishing their presence in the database.
 * - Data Integrity: On user document creation, the internal 'id' field must match the user's UID. This 'id' is then enforced as immutable on all subsequent updates.
 *
 * Denormalization for Authorization: This ruleset uses path-based authorization. By structuring the data as /users/{userId}/*, the user's UID is part of the path, making ownership checks extremely fast and simple without needing to read the document's contents (`get()` calls) for authorization.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // Helper Functions
    // ----------------------------------------------------------------------

    /**
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the fundamental ownership check.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * Ensures an operation is performed by the document owner and that the document already exists.
     * Crucial for safe update and delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * Validates a user is creating their own user document.
     * Enforces that the internal 'id' field matches the user's auth UID for relational integrity.
     */
    function isCreatingOwnUserData(userId) {
      return isOwner(userId) && request.resource.data.id == userId;
    }

    /**
     * Validates a user is updating their own document while preserving immutable fields.
     * Enforces that the 'id' field cannot be changed after creation.
     */
    function isUpdatingOwnUserData(userId) {
      return isExistingOwner(userId) && request.resource.data.id == resource.data.id;
    }


    // ----------------------------------------------------------------------
    // Collection Rules
    // ----------------------------------------------------------------------

    /**
     * @description Manages access to individual user documents and their subcollections.
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing all users.
      allow create: if isCreatingOwnUserData(userId);
      allow update: if isUpdatingOwnUserData(userId);
      allow delete: if isExistingOwner(userId);

      /**
       * @description Manages user orders.
       * @path /users/{userId}/orders/{orderId}
       * @allow A user can create new orders for themselves.
       * @allow A user can read or list their own past orders.
       * @deny A user cannot update or delete an order once it is placed to maintain integrity.
       */
      match /orders/{orderId} {
        allow create: if isOwner(userId);
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow update, delete: if false; // Orders are immutable once created.
      }
    }
  }
}
